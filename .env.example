# =============================================================================
# CodeAgents Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# REQUIRED: Portkey AI gateway key (one key reaches every catalogued model)
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Model settings (optional)
DEFAULT_MODEL=claude-sonnet-4-5
MAX_OUTPUT_TOKENS=4000
# REASONING_EFFORT=low

# Per-agent model overrides (optional) — fall back to DEFAULT_MODEL when unset
# QUALITY_MODEL=gpt-5.5
# SECURITY_MODEL=claude-opus-5
# PERFORMANCE_MODEL=gemini-2.5-pro
# DOCUMENTATION_MODEL=gpt-4.1-mini

# Run `codeagents models` to see every available model and its slug.

# Logging level (optional)
LOG_LEVEL=INFO

# Maximum code length to analyze in characters (optional)
MAX_CODE_LENGTH=50000
